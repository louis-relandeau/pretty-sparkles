#!/bin/sh
set -e

# Pre-commit hook: format staged C/C++ files with clang-format
# Finds staged files, runs clang-format -i --style=file, and re-adds them to the index.

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cpp|cc|h|hpp|hh)$' || true)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "Formatting staged C/C++ files with clang-format..."

printf '%s\n' "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    clang-format -i --style=file "$file" || { echo "clang-format failed on $file"; exit 1; }
    git add "$file"
  fi
done

exit 0
